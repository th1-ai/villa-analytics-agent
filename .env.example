# Villa Analytics Agent — environment variables
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.
#
# The skill itself does not read this file. Its settings live in the
# Configuration table of .claude/skills/villa-analytics/SKILL.md.
# `.env` is for your own PMS / GA4 / sheets tools, so their credentials
# stay out of the skill file and out of git. The names below match the
# placeholders in the skill; keep the two in step.

# ============================================================
# PMS (Property Management System) integration
# ============================================================
# The skill reads reservations from your PMS through a tool you
# supply. The example uses Cloudbeds, but any PMS with a
# reservation-list endpoint works.

PMS_REPORTS_TOOL="tools/cloudbeds_api.py"
PMS_PROPERTY_ID=""

# Cloudbeds example values (only needed if your tool uses Cloudbeds):
# CLOUDBEDS_CLIENT_ID=""
# CLOUDBEDS_CLIENT_SECRET=""
# CLOUDBEDS_ACCESS_TOKEN=""
# CLOUDBEDS_REFRESH_TOKEN=""

# ============================================================
# Google Analytics 4 (optional)
# ============================================================
# Used for the website-traffic side of the report.
# Leave blank to skip the GA4 portion.

GA4_PROPERTY_ID=""
GA4_TOKEN_PATH="~/.config/gws/analytics_token.json"

# ============================================================
# Snapshot sheet (optional)
# ============================================================
# Where to log one row of headline numbers per run, so you can
# compare month over month.

SHEET_ID_ANALYTICS=""

# ============================================================
# Sheets CLI (optional, only needed for the snapshot sheet)
# ============================================================
EMAIL_CLI="gws"
