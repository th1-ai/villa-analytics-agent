# Villa Analytics Agent — environment variables
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.

# ============================================================
# PMS (Property Management System) integration
# ============================================================
# The agent reads reservations, occupancy, and revenue numbers
# from your PMS. Reference setup uses Cloudbeds, but any PMS
# with reservation list + reports endpoints works.

PMS_LOOKUP_TOOL="tools/lookup_guest.py"
PMS_REPORTS_TOOL="tools/cloudbeds_api.py"
PMS_PROPERTY_ID=""

# Cloudbeds reference values (only needed if you use Cloudbeds):
# CLOUDBEDS_CLIENT_ID=""
# CLOUDBEDS_CLIENT_SECRET=""
# CLOUDBEDS_ACCESS_TOKEN=""
# CLOUDBEDS_REFRESH_TOKEN=""

# ============================================================
# Google Analytics 4 (optional)
# ============================================================
# Used for the website-traffic side of the analytics report.
# Leave blank to skip the GA4 portion.

GA4_PROPERTY_ID=""
GA4_TOKEN_PATH="~/.config/gws/analytics_token.json"

# ============================================================
# Output sheet (optional)
# ============================================================
# Where to log analytics snapshots over time so you can compare
# month over month.

SHEET_ID_ANALYTICS=""

# ============================================================
# Email + sheets CLI
# ============================================================
EMAIL_CLI="gws"
